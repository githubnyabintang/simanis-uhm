// Emulator-only rules. Never deploy this file to a real project.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /name/{id} { allow read, write: if false; }
    match /{collection}/{id} {
      allow read: if true;
      allow write: if !(collection == 'courses' && id == 'imp-course-blocked');
    }
  }
}
